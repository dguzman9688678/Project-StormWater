# Multi-stage build for AI Services
FROM node:18-alpine AS ai-builder

WORKDIR /app
COPY package*.json ./
COPY ai-services/package*.json ./ai-services/
COPY shared/package*.json ./shared/
RUN npm ci --only=production

COPY ai-services ./ai-services
COPY shared ./shared
COPY tsconfig.json ./

RUN cd ai-services && npm run build

# Production stage  
FROM node:18-alpine AS production

RUN addgroup -g 1001 -S nodejs
RUN adduser -S nextjs -u 1001

WORKDIR /app

COPY --from=ai-builder /app/ai-services/dist ./dist
COPY --from=ai-builder /app/ai-services/node_modules ./node_modules
COPY --from=ai-builder /app/ai-services/package.json ./package.json

USER nextjs

EXPOSE 8000

ENV NODE_ENV=production

CMD ["node", "dist/index.js"]