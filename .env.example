# Environment variables for StormWaterAI Enterprise System
# Copy this file to .env and fill in your actual values

# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/stormwater_ai
POSTGRES_DB=stormwater_ai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password

# Redis Configuration
REDIS_URL=redis://localhost:6379

# AI Services
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Authentication & Security
JWT_SECRET=your_jwt_secret_here_make_it_long_and_random
SESSION_SECRET=your_session_secret_here
ENCRYPTION_KEY=your_encryption_key_32_characters

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=50MB
ALLOWED_FILE_TYPES=pdf,docx,xlsx,txt,csv,jpg,jpeg,png,gif,bmp,tiff

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_password
FROM_EMAIL=noreply@stormwater-ai.com

# Application Configuration
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# Logging
LOG_LEVEL=info
LOG_DIR=./logs

# ARCSEC Configuration
ARCSEC_ENABLED=true
ARCSEC_CREATOR=Daniel Guzman
ARCSEC_PROJECT=StormWaterAI Enterprise System

# Monitoring & Analytics
ENABLE_ANALYTICS=true
SENTRY_DSN=your_sentry_dsn_here

# Development Only
DEVELOPMENT_MODE=true
DEBUG_SQL=false
MOCK_AI_RESPONSES=false

# Production Configuration (for production deployment)
# SSL_CERT_PATH=/path/to/ssl/cert.pem
# SSL_KEY_PATH=/path/to/ssl/key.pem
# DOMAIN=your-domain.com
# CDN_URL=https://cdn.your-domain.com